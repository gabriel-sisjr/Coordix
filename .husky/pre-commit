echo "🔍 Running pre-commit checks..."

# Format and check JavaScript/TypeScript files
echo "📝 Formatting JavaScript/TypeScript files..."
yarn prettier --write .

# Check .NET code formatting
echo "🔧 Checking .NET code formatting..."
dotnet format --verify-no-changes --verbosity quiet

if [ $? -ne 0 ]; then
  echo "❌ .NET code formatting check failed!"
  echo "💡 Run 'dotnet format' to fix formatting issues before committing."
  exit 1
fi

echo "✅ All formatting checks passed!"
